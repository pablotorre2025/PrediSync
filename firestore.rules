rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authMatchesUser(userId) {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^' + userId + '(@.*|[-].*@.*)$');
    }

    // Cada documento de sermón tiene id `${userId}__${sermonId}` y campo `userId`.
    match /sermons/{docId} {
      allow read, write: if authMatchesUser(resource == null ? request.resource.data.userId : resource.data.userId)
        && (resource == null
            ? request.resource.data.userId is string
            : resource.data.userId is string);
    }

    match /settings/{userId} {
      allow read, write: if authMatchesUser(userId)
        && (resource == null
            ? request.resource.data.userId == userId
            : resource.data.userId == userId);
    }

    match /bibleMeta/{docId} {
      // Lectura abierta a cualquier usuario autenticado (bibles son contenido público)
      // Las queries por userId no son verificables estáticamente con expresiones complejas
      allow read: if request.auth != null;
      allow write: if authMatchesUser(resource == null ? request.resource.data.userId : resource.data.userId)
        && (resource == null
            ? request.resource.data.userId is string
            : resource.data.userId is string);
    }

    match /sermonTypes/{docId} {
      // Lectura abierta a cualquier usuario autenticado (mismo motivo que bibleMeta)
      allow read: if request.auth != null;
      allow write: if authMatchesUser(resource == null ? request.resource.data.userId : resource.data.userId)
        && (resource == null
            ? request.resource.data.userId is string
            : resource.data.userId is string);
    }
  }
}
